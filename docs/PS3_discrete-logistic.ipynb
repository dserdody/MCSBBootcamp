    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "N = 0.6  # number of scoops in each jar\n",
    "n_max = 20  # max number of days to simulate\n",
    "\n",
    "x = np.zeros(n_max)  # fraction caffeinated\n",
    "x[0] = 0.599  # initial fraction caffeinated\n",
    "\n",
    "for n in range(1, n_max):\n",
    "\n",
    "    x[n] = x[n-1] + (0.1 * (1 - x[n-1]/ N) * x[n-1])\n",
    "\n",
    "# finished loop through days\n",
    "\n",
    "days = np.arange(1, n_max + 1)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.plot(days, x, \"-ok\")\n",
    "ax.set_ylabel(\"Fraction caffeinated\")\n",
    "ax.set_xlabel(\"Days\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-6",
