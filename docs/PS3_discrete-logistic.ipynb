    "    r = rarray[i]\n",
    "    #print(r)\n",
    "    \n",
    "    #rx[i] = np.zeros(0)\n",
    "    #x=np.zeros(212)\n",
    "    x[0] = 0.6\n",
    "\n",
    "    for n in range(1, 211):\n",
    "\n",
    "        x[n] = x[n-1] + (r * (1 - x[n-1]/ N) * x[n-1])\n",
    "    print(x[210])\n",
    "    rx[i,1:11] = x[200:210]\n",
    "\n",
    "#print(rx)\n",
    "# finished loop through days\n",
    "\n",
    "#days = np.arange(1, n_max + 1)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
