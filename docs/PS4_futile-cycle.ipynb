    "### Kinase : phosphatase ratio\n",
    "KP_ratio <- 10^seq(-3, 3, length.out = 500)\n",
    "active_fraction <- KP_ratio / (1 + KP_ratio)\n",
    "\n",
    "### Plot\n",
    "plot(\n",
    "  KP_ratio,\n",
    "  active_fraction,\n",
    "  type = \"l\",\n",
    "  log = \"x\",\n",
    "  lwd = 2,\n",
    "  xlab = \"Kin / Phos Ratio\",\n",
    "  ylab = \"Fraction of Act Prot\",\n",
    "  ylim = c(0, 1)\n",
    ")\n",
    "\n",
    "abline(h = c(0, 1), lty = 3)\n",
    "abline(v = 1, lty = 3)\n",
    "\n"
   ]
