    "    def dxdt(t, state):\n",
    "        \"\"\"dma/dt and dpa/dt for a gene whose protein represses it.\"\"\"\n",
    "        ma, pa = state\n",
    "\n",
    "        gamma_ma = gamma_ma0 / (1 + Kaa * pa)\n",
    "\n",
    "        dma_dt = +gamma_ma - delta_ma * ma\n",
    "        dpa_dt = +gamma_pa * ma - delta_pa * pa\n",
    "\n",
    "        return [dma_dt, dpa_dt]\n",
