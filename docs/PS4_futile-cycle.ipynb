    "        dI_dt = \n",
    "        dAP_dt = \n",
    "        dIK_dt = \n",
    "\n",
    "        return [dA_dt, dI_dt, dAP_dt, dIK_dt]\n",
    "\n",
    "    print(x[210])\n",
