    "\n",
    "        return [dma_dt, dpa_dt, dmb_dt, dpb_dt]\n",
    "\n",
    "    # Start well before t = 0 so the model has settled by the time the input arrives.\n",
    "    sol = solve_ivp(dxdt, [-10000.0, t_max], [20, 20, 0, 0])\n",
    "\n",
